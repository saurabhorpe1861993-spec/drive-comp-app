#!/bin/sh

# Default setup for gradlew
APP_BASE_NAME=`basename "$0"`
CLASSPATH="gradle/wrapper/gradle-wrapper.jar"

# Attempt to use system gradle if wrapper jar is absent in Git
if [ ! -f "$CLASSPATH" ]; then
    if command -v gradle >/dev/null 2>&1; then
        exec gradle "$@"
    else
        echo "Downloading Gradle..."
        gradle_version="8.5"
        curl -sLO "https://services.gradle.org/distributions/gradle-${gradle_version}-bin.zip"
        unzip -q "gradle-${gradle_version}-bin.zip"
        exec "./gradle-${gradle_version}/bin/gradle" "$@"
    fi
fi

exec java -jar "$CLASSPATH" "$@"
